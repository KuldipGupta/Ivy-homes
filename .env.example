# ==========================================
# Ivy Homes Property Marketplace Environment
# ==========================================

# Base URL for the official Ivy Homes API
IVY_API_BASE_URL=https://solve.ivy.homes

# Your unique API Key issued by Ivy Homes (kept server-side, NEVER exposed to client)
IVY_API_KEY=YOUR_API_KEY

# Local or cloud MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/ivy_homes_db

# Secret key for server-issued JWT / session validation
JWT_SECRET=YOUR_JWT_SECRET_HERE

# Backend port
PORT=5000

# Frontend application URL for CORS configuration
CLIENT_URL=http://localhost:5173
